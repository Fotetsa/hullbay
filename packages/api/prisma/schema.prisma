// Schéma Prisma de l'ops-panel.
// RAPPEL : PostgreSQL est un CACHE de confort. La source de vérité redondante du
// désiré déployé vit dans les labels Docker bozando.* (voir @hullbay/shared).
// rebuildFromDocker() peut reconstruire ces tables depuis Docker seul.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // -> bozando.projectId / projectSlug
  description String?
  status      String   @default("draft") // draft | deployed | partial | error
  nodes       Node[]
  edges       Edge[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clusterId   String
  cluster     Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  // Phase 5B : tenant propriétaire.
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

model Node {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type String // container | network | volume | gateway
  name String // unique par projet -> bozando.nodeName

  // Position canvas (React Flow) -> bozando.canvas.x / y
  posX Float
  posY Float

  // Config typée selon `type` (validée par les schémas Zod de @hullbay/shared)
  // -> encodée dans bozando.spec
  config Json

  // ── Runtime observé (rempli par l'observer, NON source de vérité) ──
  dockerId    String? // containerId / networkId / nom de volume
  actualState String? // running | exited | created | missing | unknown ...
  desiredHash String? // -> bozando.desiredHash, diff idempotent

  edgesFrom Edge[] @relation("EdgeSource")
  edgesTo   Edge[] @relation("EdgeTarget")

  @@unique([projectId, name])
  @@index([projectId])
}

model Edge {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sourceNodeId String
  targetNodeId String
  source       Node   @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target       Node   @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  kind   String @default("network") // network | volume | gateway
  config Json?

  @@index([projectId])
}

// ── V2 : auth multi-utilisateur + audit ──
// Phase 2 (modèle identité) : les CRÉDENTIELLES vivent sur AuthIdentity (kind=local).
// User ne porte que ses attributs + ses memberships par tenant. `role` est un MIRROR
// temporaire (compat V1) — supprimé en fin de Phase 5B (le rôle réel = Membership.role).
model User {
  id        String   @id @default(cuid())
  email     String?  @unique // attribut, jamais identifiant primaire (iss+sub fait foi)
  name      String?
  locale    String?
  role      String   @default("owner") // MIRROR temporaire : owner | operator | viewer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities  AuthIdentity[]
  memberships Membership[]
  sessions  UserSession[]

  auditLogs AuditLog[]
  updates   SystemUpdate[]
}

// Une identité = un compte auprès d'UN provider (ou local). Un même User cumule :
// local + oidc + saml + ... (aucun provider privilégié). subject = sub OIDC /
// NameID SAML / stableAttr LDAP / "local:<userId>".
model AuthIdentity {
  id           String   @id @default(cuid())
  userId       String
  providerId   String   // id du provider (voir AuthProvider / seeds registry)
  kind         String   // local | oidc | oauth2 | saml | ldap
  issuer       String?  // obligatoire pour oidc/saml ; NULL pour local/ldap-bind
  subject      String
  email        String?

  // Crédenciales locales uniquement (kind=local)
  passwordHash String?
  mfaSecretEnc String? // secret TOTP chiffré (AES-256-GCM, scope "mfa")
  mfaEnabled   Boolean  @default(false)

  createdAt   DateTime @default(now())
  lastLoginAt DateTime?

  webauthnCredentials WebauthnCredential[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, issuer, subject])
  @@index([userId])
}

// Credentials WebAuthn / Passkeys 
model WebauthnCredential {
  id           String       @id @default(cuid())
  identityId   String
  credentialId String       @unique
  publicKey    Bytes
  counter      BigInt       @default(0)
  deviceType   String?
  backedUp     Boolean      @default(false)
  transports   String?
  name         String?
  createdAt    DateTime     @default(now())
  lastUsedAt   DateTime?

  identity     AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  memberships         Membership[]
  // Phase 5B : ressources tenant-scopées — §4.4 du plan.
  projects                 Project[]
  clusters                 Cluster[]
  servers                  Server[]
  registryCredentials      RegistryCredential[]
  settings                 Settings[]
  auditLogs                AuditLog[]
  authProviders            AuthProvider[]
  securityPolicies         SecurityPolicy[]
  roles                    Role[]
  teams                    Team[]
  plicies                  Policy[]
  externalGroupMappings    ExternalGroupMapping[]
}

// Rôle = propriété de la MEMBERSHIP, pas du User. Phase 2 : tenant par défaut unique.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   // owner | operator | viewer
  roleId    String?
  createdAt DateTime @default(now())

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef     Role? @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: SetNull)
  TeamMembers TeamMember[]

  @@unique([userId, tenantId])
  @@unique([tenantId, id])
}

// Providers d'authentification. id généré — JAMAIS de défaut vendor (correction N°4).
// local est un provider comme les autres ; oidc/saml/ldap ne sont que des
// configurations de protocole (aucune intégration vendor : correction N°7).
model AuthProvider {
  id        String   @id @default(cuid())
  kind      String   // local | oidc | oauth2 | saml | ldap
  name      String   // nom libre : "Entra Corp", "Company LDAP", "Local"...
  enabled   Boolean  @default(false)
  config    Json     @default("{}") // champs sensibles CHIFFRÉS individuellement (§8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 5B : null = provider global (disponible pour tous les tenants) — §4.2, correction N°22.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])

  externalGroupMappings    ExternalGroupMapping[]
}

// Identité inconnue d'un provider → ligne "pending" (jamais de User créé en auto).
// Le workflow d'approbation effectif (owner → User + AuthIdentity + Membership)
// est livré en Phase 5A (correction N°20). Phase 2 : tableau prête, remplie en 3/4.
model PendingIdentity {
  id                   String   @id @default(cuid())
  providerId           String
  issuer               String?
  subject              String
  email                String?
  emailVerified        Boolean  @default(false) // OIDC email_verified au mapping
  name                 String?
  requestedForTenantId String?
  status               String   @default("pending") // pending | approved | rejected
  createdAt            DateTime @default(now())

  @@unique([providerId, issuer, subject])
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  identityId String?
  jti        String    @unique
  providerId String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ip         String?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([jti])
}

model SecurityPolicy {
  id                String   @id @default(cuid())
  sessionTtlMs      Int     @default(43200000)
  // backoff rate-limit persistant par tenant (rate-limit.ts lit
  // `getPolicy()` sync — on ne durcit plus ces 2 valeurs inertes en mémoire).
  rateBaseBackoffMs Int     @default(30000)
  rateMaxBackoffMs  Int     @default(600000)
  mfaRequireRoles   String  @default("[]")
  loginFailLimit    Int     @default(5)
  loginFailWindowMs Int     @default(60000)
  lockoutMs         Int     @default(300000)
  providerAllowlist String  @default("[]")
  updatedAt         DateTime @updatedAt

  // une policy PAR tenant (fin du singleton) .
  tenantId          String @unique
  tenant            Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // deploy | destroy | rebuild | server.provisioned | ...
  projectId String?
  nodeId    String?
  serverId  String?
  ip        String?
  payload   Json
  createdAt DateTime @default(now())

  // tenant de l'action (nullable : événements système sans tenant).
  tenantId  String?
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  @@index([tenantId])
  @@index([projectId])
  @@index([createdAt])
}

// ── Serveurs physiques du cluster Swarm (provisioning SSH one-shot) ──
model Server {
  id            String   @id @default(cuid())
  name          String
  host          String
  port          Int      @default(22)
  user          String   @default("root")
  role          String // manager | worker
  status        String   @default("provisioning") // provisioning | ready | error | draining | down
  swarmNodeId   String? // ID du nœud dans Swarm
  // Clé OUTIL (générée par l'app) privée chiffrée AES-256-GCM. JAMAIS la clé perso de l'utilisateur.
  privateKeyEnc String?
  publicKey     String? // clé-outil publique (déposée dans authorized_keys)
  hostKeyFp     String? // empreinte SSH connue (TOFU known_hosts)
  lastError     String?
  systemInfo   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clusterId     String
  cluster       Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  // tenant propriétaire.
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

// ── Credentials de registre Docker (GHCR) — pour pull sur chaque nœud ──
model RegistryCredential {
  id        String   @id @default(cuid())
  registry  String   @default("ghcr.io")
  username  String
  tokenEnc  String // token/password chiffré AES-256-GCM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // tenant propriétaire.
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

// ── Parametre systeme - domaine public configurable (par tenant en 5B) ──
// ── Configuration WebAuthn (RP publique, jamais de secret) : source de vérité
// pour les cérémonies de passkeys, résolue par tenant. Remplaçait WEBAUTHN_* env.
model Settings {
  id               String  @id @default(cuid())
  domain           String?
  webauthnEnabled  Boolean @default(false)
  webauthnOrigin   String?
  webauthnRpId     String?
  webauthnRpName   String  @default("Hullbay")
  updatedAt        DateTime @updatedAt

  tenantId         String @unique
  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ── Cluster Docker swarm (TON TRAVAIL) ──
model Cluster {
  id            String @id @default(cuid())
  name          String
  dockerHost    String
  caddyAdminUrl String
  isDefault     Boolean @default(false)
  status        String   @default("pending")
  deletingAt    DateTime?
  servers       Server[]
  projects      Project[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // nom unique PAR tenant (ex-@unique global).
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, name])
  @@index([tenantId])
}


// ── Mises à jour du système (instances auto-hébergées) ──
// SystemInfo : singleton reflétant l'état courant de l'installation.
// currentVersion est seedé au boot depuis l'env IMAGE_TAG (source de vérité déployée).
model SystemInfo {
  id              String    @id @default("singleton")
  currentVersion  String    @default("unknown")
  updateChannel   String    @default("stable") // stable | beta
  lastCheckAt     DateTime?
  lastCheckResult Json?
  // Audit des changements de canal : [{ at, from, to }], dernier au début (max 10).
  channelHistory  Json      @default("[]")
  updatedAt       DateTime  @updatedAt
}

// Un historique de mise à jour : une entrée par apply/rollback.
// steps/logs : JSON array, persistés pour traçabilité post-mortem (le process API
// meurt pendant l'update de lui-même — la finalisation a lieu au boot suivant).
model SystemUpdate {
  id            String      @id @default(cuid())
  status        String      @default("pending") // pending | running | success | failed | rolled_back
  fromVersion   String
  toVersion     String
  channel       String      @default("stable")
  steps         Json        @default("[]")
  logs          Json        @default("[]")
  error         String?
  // Rollback : l'update d'origine réussie est marquée rolledBack une fois annulée ;
  // le rollback crée un NOUVEL enregistrement (rollbackOfId → l'update source).
  rolledBack    Boolean     @default(false)
  rollbackOfId  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  triggeredById String?
  triggeredBy   User?       @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([rollbackOfId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isPreset    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  teamRoles       TeamRole[]
  memberships     Membership[]
  policyBindings  PolicyBinding[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([resource, action])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String
  scopeType    String
  scopeId      String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, scopeType, scopeId])
  @@index([roleId])
  @@index([permissionId])
  @@index([scopeType, scopeId])
}

model Team {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members               TeamMember[]
  roles                 TeamRole[]
  externalGroupMappings ExternalGroupMapping[]
  policyBindings        PolicyBinding[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model TeamMember {
  id           String   @id @default(cuid())
  tenantId     String
  teamId       String
  membershipId String
  joinedAt     DateTime @default(now())

  team       Team       @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)
  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([membershipId])
}

model TeamRole {
  id        String @id @default(cuid())
  tenantId  String
  teamId    String
  roleId    String
  scopeType String
  scopeId   String

  team Team @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@unique([teamId, roleId, scopeType, scopeId])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([teamId])
  @@index([roleId])
  @@index([scopeType, scopeId])
}

model Policy {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  effect      String
  conditions  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bindings PolicyBinding[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model PolicyBinding {
  id        String  @id @default(cuid())
  tenantId  String
  policyId  String
  roleId    String?
  teamId    String?
  scopeType String?
  scopeId   String?

  policy Policy @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Cascade)
  role   Role?  @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  team   Team?  @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([policyId])
  @@index([roleId])
  @@index([teamId])
  @@index([scopeType, scopeId])
}

// La relation vers AuthProvider reste une clé étrangère simple, pas composite.
// AuthProvider.tenantId peut être vide pour un fournisseur global, partagé par
// tous les tenants. Une clé composite exigerait une égalité stricte entre les
// deux tenants, ce qui ne serait jamais vrai pour un fournisseur global, et
// PostgreSQL ne sait pas exprimer nativement une contrainte du type égaux ou
// l'un des deux est vide sans un déclencheur écrit à la main. La règle réelle,
// le tenant du mapping doit soit correspondre au tenant du fournisseur, soit
// le fournisseur doit être global, est donc vérifiée par le service applicatif
// au moment de la création d'un mapping, documentée ici comme limite assumée
// de cette phase plutôt que contournée en silence.
model ExternalGroupMapping {
  id                String   @id @default(cuid())
  tenantId          String
  providerId        String
  externalGroupName String
  teamId            String
  createdAt         DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider AuthProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  team     Team         @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, providerId, externalGroupName])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([providerId])
  @@index([teamId])
}